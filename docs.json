{
  "$schema": "https://mintlify.com/docs.json",
  "name": "NervesHub",
  "theme": "palm",
  "colors": {
    "primary": "#6366f1",
    "light": "#818cf8",
    "dark": "#4f46e5"
  },
  "favicon": {
    "light": "/images/favicon.svg",
    "dark": "/images/favicon.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "href": "https://manage.nervescloud.com",
      "label": "Dashboard"
    },
    "links": [
      {
        "href": "https://help.nervescloud.com/roadmap",
        "label": "Roadmap"
      },
      {
        "href": "https://help.nervescloud.com/changelog",
        "label": "Changelog"
      },
      {
        "href": "https://help.nervescloud.com",
        "label": "Feedback"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "architecture",
              "terminology"
            ]
          },
          {
            "group": "Setup",
            "pages": [
              "setup/add-to-project",
              "setup/connecting",
              "setup/products",
              "setup/devices",
              "setup/firmware",
              "setup/deployments"
            ]
          },
          {
            "group": "Device Authentication",
            "pages": [
              "auth/shared-secret",
              "auth/device-certificates",
              "auth/nerveskey"
            ]
          },
          {
            "group": "Device Management",
            "pages": [
              "management/fleet-overview",
              "management/remote-console",
              "management/health-monitoring",
              "management/delta-updates"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "concepts/pki",
              "concepts/firmware-signing",
              "concepts/deployments"
            ]
          },
          {
            "group": "CLI",
            "pages": [
              "cli/installation",
              "cli/configuration",
              "cli/reference"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "HTTP API",
            "pages": [
              "api/overview",
              "api/authentication",
              "api/devices",
              "api/firmware",
              "api/deployments",
              "api/organizations"
            ]
          },
          {
            "group": "Device WebSocket",
            "pages": [
              "api/websocket-overview",
              "api/websocket-events"
            ]
          },
          {
            "group": "NervesHubLink",
            "pages": [
              "api/nerveshublink-config",
              "api/nerveshublink-client"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/concepts/terminology",
      "destination": "/terminology",
      "permanent": true
    }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/nerves-hub"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ],
    "display": "header"
  },
  "logo": {
    "light": "/images/logo-lockup-light-t.png",
    "dark": "/images/logo-lockup-dark.png",
    "href": "https://nerves-hub.org"
  }
}
