  "keyFeatures": [
    "Signed over-the-air (OTA) firmware updates with cryptographic signatures",
    "Delta firmware updates — ship only binary diffs (up to 95% size reduction)",
    "Remote IEx console and shell access to any connected device",
    "Deployment groups — target devices by tag and version condition with staged rollouts",
    "Device health monitoring — CPU, memory, load, alarms, and custom metrics",
    "Mutual TLS (mTLS) device authentication with X.509 certificates",
    "NervesKey hardware security module support (ATECC508A/608A)",
    "Shared Secret authentication for easy development onboarding",
    "OpenAPI-documented HTTP REST API",
    "Self-hosted or fully managed (NervesCloud) deployment options",
    "Scales to 400,000+ devices per instance",
    "nh CLI with Homebrew install, CI/CD-friendly environment variables"
  ],
  "publicApiSurface": [
    "GET /users/me",
    "GET /orgs/{org}/keys",
    "POST /orgs/{org}/keys",
    "GET /orgs/{org_name}/products",
    "POST /orgs/{org_name}/products",
    "PUT /orgs/{org_name}/products/{product_name}",
    "DELETE /orgs/{org_name}/products/{product_name}",
    "GET /devices/{id}",
    "GET /orgs/{org_name}/products/{product_name}/deployments",
    "POST /orgs/{org_name}/products/{product_name}/deployments",
    "PUT /orgs/{org_name}/products/{product_name}/deployments/{name}",
    "CRUD /orgs/{org_name}/products/{product_name}/firmwares",
    "CRUD /orgs/{org_name}/products/{product_name}/devices/{id}/certificates",
    "CRUD /orgs/{org_name}/ca_certificates",
    "WSS wss://{host}/socket/websocket — Phoenix Channels device topic",
    "WSS event: update (firmware_url, firmware_meta)",
    "WSS event: reboot",
    "WSS event: fwup_progress",
    "WSS event: status_update",
    "NervesHubLink.Client behaviour — update_available/1 callback",
    "nh user auth / login / whoami",
    "nh device list / show / create / update / delete / reboot / console / logs",
    "nh firmware upload / sign / list / show / download",
    "nh deployment create / update / list / show",
    "nh key create / list / show / delete",
    "nh ca generate / upload / list / delete",
    "nh config set / get / unset"
  ]
